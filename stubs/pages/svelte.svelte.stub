<script module lang="ts">
    /**
     * A public page: render it without the app's default Inertia layout (a starter kit's
     * AppLayout and its sidebar). To use the default layout instead, delete this export;
     * to use another layout, `export const layout = PublicLayout`.
     */
    export const layout = (_h: unknown, page: unknown) => page
</script>

<script lang="ts">
    import { AlfakitComponent, type StandaloneComponentSchema } from '@alfakit/svelte'

    /**
     * A form built with the AlfaKit Forms plugin, served by its public route (/forms/{slug}).
     * The fields, validation and conditional logic all come from the server.
     */
    let {
        form,
        meta,
    }: {
        form: StandaloneComponentSchema
        meta: { title: string; description: string | null; slug: string; preview: boolean; poweredBy?: string | null }
    } = $props()
</script>

<svelte:head>
    <title>{meta.title}</title>
    {#if meta.description}<meta name="description" content={meta.description} />{/if}
    {#if meta.preview}<meta name="robots" content="noindex" />{/if}
</svelte:head>

<main class="min-h-svh bg-muted/40 px-4 py-8 sm:py-16">
    <AlfakitComponent
        component={form}
        class="mx-auto w-full max-w-2xl rounded-xl border bg-background p-5 shadow-sm sm:p-10"
    />
    <!-- "Powered by AlfaKit · Alfa Six", only when FormsPlugin::poweredBy() is on. -->
    {#if meta.poweredBy}<div class="mt-6">{@html meta.poweredBy}</div>{/if}
</main>
